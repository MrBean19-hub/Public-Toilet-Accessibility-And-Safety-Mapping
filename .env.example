# Copy this file to `.env` and adjust. Every value is optional: the app runs
# with the defaults shown here. Variables must start with VITE_ to be exposed
# to the browser. Never put secret keys in a VITE_ variable.

# Branding
VITE_APP_NAME=SafeStop

# Where the map opens before the user shares their location
VITE_DEFAULT_LAT=28.6139
VITE_DEFAULT_LNG=77.2090
VITE_DEFAULT_ZOOM=13

# Map tiles (any XYZ tile server). The default is OpenStreetMap's public tiles,
# fine for demos. Use a provider with an API key plan for production traffic.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Minutes a visitor must wait between two reviews of the same place (anti-spam)
VITE_REVIEW_COOLDOWN_MIN=5

# Roadmap placeholders (not used by the prototype yet):
# VITE_API_BASE_URL=https://your-backend.example.com
# VITE_VISION_API_URL=https://your-vision-service.example.com/audit
